// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

enum AccountType {
  NORMAL
  CREATOR
  ADMIN
}

enum ContentType {
  ARTICLE
  IMAGE
  VIDEO
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  COMPLETED
  REJECTED
}

model User {
  id           String      @id @default(cuid())
  name         String
  username     String      @unique
  email        String      @unique
  passwordHash String
  accountType  AccountType @default(NORMAL)

  bio          String?
  profileImage String?

  // Productivity streak — kept denormalized on User so login/feed loads
  // don't need to scan ProductivityCount to compute it.
  streak       Int       @default(0)
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectedGenres UserGenre[]

  contents Content[]

  posts         Post[] @relation("PostAuthor")
  taggedInPosts Post[] @relation("PostTaggedCreator")

  likes  Like[]
  shares Share[]

  sentRelationships     Relationship[] @relation("RelationshipSender")
  receivedRelationships Relationship[] @relation("RelationshipReceiver")

  createdChallenges Challenge[]
  userChallenges    UserChallenge[]

  productivityCounts ProductivityCount[]

  @@index([accountType])
  @@index([username])
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  users    UserGenre[]
  contents Content[]
}

model UserGenre {
  id String @id @default(cuid())

  userId  String
  genreId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, genreId])
  @@index([userId])
  @@index([genreId])
}

model Content {
  id          String      @id @default(cuid())
  title       String
  description String?
  body        String?
  type        ContentType

  externalUrl String?
  mediaUrl    String?

  // Single genre per post, matching the "creator picks one category" rule.
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id])

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  likes  Like[]
  shares Share[]

  challenge Challenge?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([type])
  @@index([createdAt])
  @@index([genreId, createdAt])
}

model Post {
  id      String @id @default(cuid())
  content String

  mediaUrl String?

  authorId String
  author   User   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  challengeId String?        @unique
  challenge   UserChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  taggedCreatorId String?
  taggedCreator   User?   @relation("PostTaggedCreator", fields: [taggedCreatorId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([challengeId])
  @@index([taggedCreatorId])
}

model Like {
  id String @id @default(cuid())

  userId    String
  contentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

model Share {
  id String @id @default(cuid())

  userId    String
  contentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([contentId])
}

model Relationship {
  id String @id @default(cuid())

  senderId   String
  receiverId String

  status FollowStatus @default(PENDING)

  sender   User @relation("RelationshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("RelationshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model Challenge {
  id String @id @default(cuid())

  title       String
  description String

  contentId String  @unique
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  userChallenges UserChallenge[]
}

model UserChallenge {
  id String @id @default(cuid())

  userId      String
  challengeId String

  // Offered -> PENDING; user acts on it -> ACCEPTED/REJECTED; finished -> COMPLETED.
  status ChallengeStatus @default(PENDING)

  offeredAt   DateTime  @default(now())
  acceptedAt  DateTime?
  completedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  resultPost Post?

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
}

model ProductivityCount {
  id String @id @default(cuid())

  userId String
  date   DateTime @db.Date
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}
